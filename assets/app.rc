#include <windows.h>
101 ICON "connected.ico"
102 ICON "blocked.ico"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION 0,2,0,2
 PRODUCTVERSION 0,2,0,2
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Toggle External Connection"
      VALUE "FileVersion", "0.2.0-rc.2"
      VALUE "ProductName", "Toggle External Connection"
      VALUE "ProductVersion", "0.2.0-rc.2"
      VALUE "OriginalFilename", "ToggleExternalConnection.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
